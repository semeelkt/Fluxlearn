# MongoDB connection string (MongoDB Atlas or self-hosted, must support replica sets for Prisma)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reliare?retryWrites=true&w=majority"

# The single administrator password for /admin — choose something long and random.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
