generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Author {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  photo       String?
  bio         String?
  twitter     String?
  website     String?
  articles    Article[] @relation("ArticleAuthor")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String    @unique
  description     String?
  banner          String?
  seoTitle        String?
  seoDescription  String?
  order           Int       @default(0)
  hidden          Boolean   @default(false)
  articles        Article[] @relation("ArticleCategory")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Article {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String        @unique
  summary         String
  content         String        // TipTap JSON, stored as string
  coverImage      String?
  status          ArticleStatus @default(DRAFT)
  featured        Boolean       @default(false)
  editorsPick     Boolean       @default(false)
  tags            String[]
  readingTime     Int           @default(5)
  views           Int           @default(0)
  publishedAt     DateTime?
  scheduledFor    DateTime?

  authorId        String        @db.ObjectId
  author          Author        @relation("ArticleAuthor", fields: [authorId], references: [id])

  categoryId      String        @db.ObjectId
  category        Category      @relation("ArticleCategory", fields: [categoryId], references: [id])

  references      String[]      // citation/reference strings
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model ResearchPaper {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String    @unique
  abstract        String
  authorName      String
  journal         String?
  doi             String?
  publicationDate DateTime?
  category        String?
  coverImage      String?
  pdfUrl          String
  downloads       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MediaItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  filename  String
  url       String
  type      String   // "image" | "pdf"
  folder    String?  @default("uploads")
  size      Int?
  createdAt DateTime @default(now())
}

model Settings {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  siteName      String  @default("Reliare")
  tagline       String  @default("Where Knowledge Meets Clarity.")
  logo          String?
  favicon       String?
  contactEmail  String?
  twitter       String?
  instagram     String?
  facebook      String?
  seoTitle      String?
  seoDescription String?
  newsletterHeadline String?
  newsletterCopy     String?
}

model SearchLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  query     String
  createdAt DateTime @default(now())
}
